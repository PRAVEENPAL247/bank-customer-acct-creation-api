#%RAML 1.0
title: bank-customer-acct-creation
description: Api for bank customer account creation
version: v1
baseUri: http://localhost:8081/createAccount
protocols:
  - HTTP
  - HTTPS

securitySchemes:
  basic: !include Security-Schema/securityScheme.raml

securedBy:
  - basic

/createAccount:
  post:
    queryParameters:
      customerName:
        required: true
        minLength: 4
        maxLength: 45
      bank:
        required: true
        enum:
          - ICICI
          - AXIS
          - HDFC
          - SBI
      type:
        required: true
        enum:
          - savings
          - current
      branchName:
        required: true
        minLength: 4
        maxLength: 10
    body:
      application/json:
        type: !include  /DataTypes/InputdataType.raml
        example: !include /examples/request/inputRequestexample.raml
          
    responses:
      201:
        body:
          application/json:
            type: object
            properties:
              status:
                required: true
                type: string
                example: "Account Created Successfully with Account Number xxxxxxxxxx"
            example: !include /examples/response/successResponseExample.raml      


        
        